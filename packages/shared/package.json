{
  "name": "@flagken/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Flag types, the rules engine and deterministic bucketing, shared by the server, the SDK and the console.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
