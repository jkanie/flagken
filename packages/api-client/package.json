{
  "name": "@flagken/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed client for the flagken HTTP API, generated from the server's OpenAPI document.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./openapi.json": "./openapi.json"
  },
  "files": [
    "dist",
    "openapi.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate": "node scripts/generate.mjs write",
    "check": "node scripts/generate.mjs check"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
