# Copy to .env and fill in. Every value is empty here on purpose: README.md lists defaults and meanings.
# The server reads .env from the repository root in `pnpm dev:server` and `pnpm --filter @flagken/server cli`.

# Required
DATABASE_URL=
REDIS_URL=
SESSION_SECRET=

# Server
NODE_ENV=
HOST=
PORT=
LOG_LEVEL=
TRUST_PROXY=
COOKIE_SECURE=
SESSION_TTL_HOURS=
CORS_ORIGINS=
CONSOLE_DIR=
DOCS_ENABLED=
MIGRATE_ON_START=
REDIS_PREFIX=

# Limits
RATE_LIMIT_PER_MINUTE=
LOGIN_RATE_LIMIT_PER_MINUTE=

# Background jobs and webhooks
WORKERS_ENABLED=
WEBHOOK_TIMEOUT_MS=
WEBHOOK_MAX_ATTEMPTS=
WEBHOOK_BACKOFF_MS=
ALLOW_PRIVATE_TARGETS=
SSE_HEARTBEAT_MS=

# Observability
METRICS_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_SERVICE_NAME=

# Only for `node dist/cli.js create-admin`
ADMIN_EMAIL=
ADMIN_PASSWORD=
